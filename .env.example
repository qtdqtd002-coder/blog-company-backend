# ============================================================
# 블로그 컴퍼니 백엔드 — 환경설정 예시
# 실제 값을 채운 뒤 이 파일을 ".env"로 복사하세요.  (cp .env.example .env)
# ★ .env 와 실제 키는 절대 git 에 커밋하지 마세요 (.gitignore 처리됨).
# ============================================================

# --- 서버 ---
PORT=8080
# API 경로 프리픽스. PWA api.js 의 PUBLISH_API_BASE_URL 이 이 base 를 가리킨다.
# 예) BASE_PATH=/api  → 엔드포인트는 /api/requests, /api/health ...
BASE_PATH=
# CORS 허용 출처(쉼표 구분). PWA 가 올라간 GitHub Pages 출처를 넣는다.
# 예) https://qtdqtd002-coder.github.io
CORS_ORIGINS=https://qtdqtd002-coder.github.io
# 비워두면 모든 출처 허용(개발용). 운영에선 반드시 명시.

# 관리자 토큰 — 상태 갱신(POST /requests/:id/status), 푸시 발송 등 쓰기 엔드포인트 보호.
# 작성 러너(PC의 Claude Code 예약 루틴)가 이 토큰을 X-Admin-Token 헤더로 보낸다.
# deploy.sh 가 비어 있으면 자동 발급. 외부 노출 금지.
ADMIN_TOKEN=

# --- 웹 푸시(VAPID) ---
# `npm run gen:vapid` 로 생성한 값을 붙여넣으세요.
# 공개키(PUBLIC)는 PWA api.js 의 VAPID_PUBLIC_KEY 에도 동일하게 넣습니다(공개되어도 안전).
# 비밀키(PRIVATE)는 서버에만 보관, 외부 노출 금지.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- 에이전트 러너 (2b 에서 사용) ---
# 키가 없으면 러너는 'stub' 모드로 동작(실제 생성·발행 안 함, 파이프라인만 검증).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- 깃 발행 대상 (2b 에서 사용) ---
# 글을 푸시할 GitHub Pages 저장소.
GITHUB_TOKEN=
GIT_PUBLISH_REPO=qtdqtd002-coder/bomding-blog-preview
GIT_PUBLISH_BRANCH=main
GIT_AUTHOR_NAME=blog-company-bot
GIT_AUTHOR_EMAIL=bot@example.com

# --- 스케줄러 ---
# 신작 글 자동 생성 주기(cron). 기본 2시간마다.
AUTO_GEN_CRON=0 */2 * * *
# 자동 생성 on/off (2b 전까지는 stub 호출만). true/false
AUTO_GEN_ENABLED=false

# --- stale 'processing' 자동 회수 (상시 동작) ---
# 작성 러너(PC)가 처리 도중 중단되면 요청이 'processing' 에 영구히 박힌다.
# 아래 시간(ms)보다 오래 'processing' 인 요청을 자동으로 received(재시도)/failed(종결)로 복구.
# 정상 파이프라인 최대 소요보다 넉넉히 둘 것(너무 짧으면 작성 중인 글을 중복 발행할 위험).
RECLAIM_AFTER_MS=3600000
# 이 횟수 이상 'processing' 시도(=회수)되면 더 안 돌리고 failed 로 종결.
RECLAIM_MAX_ATTEMPTS=3
# 회수 스윕 주기(cron). 기본 10분.
RECLAIM_SWEEP_CRON=*/10 * * * *
