# 의존성
node_modules/

# 비밀: 실제 키는 절대 커밋하지 않는다
.env
.env.local
*.pem

# 작성 러너(PC) 설정 — ADMIN_TOKEN 포함, 절대 커밋 금지
.runner.config.json

# 런타임 데이터(요청/구독 저장소) — 서버 로컬에만 존재
data/*.json
!data/.gitkeep

# 업로드된 1회용 참고문서(외주 첨부) — 처리 후 삭제, 절대 커밋 금지
data/uploads/

# 외주 일감 캘린더 일일 스냅샷(단가·수입 = 금액 정보) — 서버에만, 절대 커밋 금지
data/cal-history/

# 로그
*.log
npm-debug.log*
logs/

# OS
.DS_Store
Thumbs.db
